rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isWithinSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // User profile pictures
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isWithinSizeLimit();
    }
    
    // User community post uploads
    match /users/{userId}/uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isWithinSizeLimit();
    }
    
    // Official village gallery uploads
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isWithinSizeLimit();
    }
    
    // Event banners
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && isWithinSizeLimit();
    }
  }
}
