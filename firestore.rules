rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (matches request.auth.uid)
// Fields:
//   - uid: string (required, immutable)
//   - name: string (required, 1-100 chars)
//   - email: string (optional, valid email format)
//   - phone: string (optional, 10-20 chars)
//   - role: string ('SUPER_ADMIN', 'ADMIN', 'MODERATOR', 'SPORTS_ORGANIZER', 'EVENT_ORGANIZER', 'USER')
//   - account_status: string ('ACTIVE', 'SUSPENDED', 'BANNED')
//   - created_at: string (ISO date string, immutable)
//   - last_login: string (ISO date string)
//
// Collection: news
// Document ID: {newsId}
// Fields:
//   - id: string (required, immutable)
//   - title_en: string (required, 1-200 chars)
//   - title_kn: string (required, 1-200 chars)
//   - content_en: string (required, 1-10000 chars)
//   - content_kn: string (required, 1-10000 chars)
//   - author_id: string (required, matches request.auth.uid, immutable)
//   - author_name: string (required, 1-100 chars)
//   - verification_status: string ('PENDING', 'VERIFIED', 'REJECTED', 'COMMUNITY_REPORT')
//   - urgent: bool (required)
//   - created_at: string (ISO date string, immutable)
//
// Collection: events
// Document ID: {eventId}
// Fields:
//   - id: string (required, immutable)
//   - title_en: string (required, 1-200 chars)
//   - title_kn: string (required, 1-200 chars)
//   - event_date: string (required, 1-50 chars)
//   - location_en: string (required, 1-200 chars)
//   - participants_count: number (>= 0)
//   - registered_uids: list (list of user IDs)
//
// Collection: comments
// Document ID: {commentId}
// Fields:
//   - id: string (required, immutable)
//   - post_id: string (required, 1-100 chars)
//   - author_id: string (required, matches request.auth.uid, immutable)
//   - author_name: string (required, 1-100 chars)
//   - text: string (required, 1-2000 chars)
//   - created_at: string (ISO date string, immutable)
//
// Collection: reports
// Document ID: {reportId}
// Fields:
//   - id: string (required, immutable)
//   - item_id: string (required)
//   - item_type: string ('POST', 'USER', 'COMMENT', 'MESSAGE')
//   - reporter_id: string (required, matches request.auth.uid, immutable)
//   - reason: string (required, 1-1000 chars)
//   - status: string ('PENDING', 'RESOLVED', 'DISMISSED')
//   - created_at: string (ISO date string, immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Core Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == role;
    }

    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }

    function isAdmin() {
      return isSuperAdmin() || hasRole('ADMIN');
    }

    function isModerator() {
      return isAdmin() || hasRole('MODERATOR');
    }

    function isSportsOrganizer() {
      return isAdmin() || hasRole('SPORTS_ORGANIZER');
    }

    function isEventOrganizer() {
      return isAdmin() || hasRole('EVENT_ORGANIZER');
    }

    function validStringLength(text, minLen, maxLen) {
      return text is string && text.size() >= minLen && text.size() <= maxLen;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Users Collection (Strict PII Lockdown: Owner or Admin Only)
    // ===============================================================
    match /users/{userId} {
      // PII Protection: Only the account owner or admins can read full profile details
      allow read: if isOwner(userId) || isAdmin();

      // Creating profile: users can create their own document with default role 'USER'
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'USER' &&
        validStringLength(request.resource.data.name, 1, 100);

      // Updating profile: users cannot escalate their own role or unban themselves
      allow update: if (
        isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'account_status'])
      ) || isAdmin();

      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // News & Community Posts
    // ===============================================================
    match /news/{newsId} {
      // Verified news & reports are readable by all; unverified drafts only by author/moderator
      allow read: if resource.data.verification_status in ['VERIFIED', 'COMMUNITY_REPORT'] ||
                     isModerator() ||
                     (isAuthenticated() && resource.data.author_id == request.auth.uid);

      // Regular citizens can create pending posts, moderators can publish immediately
      allow create: if isAuthenticated() &&
        request.resource.data.author_id == request.auth.uid &&
        validStringLength(request.resource.data.title_en, 1, 200) &&
        validStringLength(request.resource.data.title_kn, 1, 200) &&
        validStringLength(request.resource.data.content_en, 1, 10000) &&
        validStringLength(request.resource.data.content_kn, 1, 10000) &&
        (isModerator() || (request.resource.data.verification_status in ['PENDING', 'COMMUNITY_REPORT'] && request.resource.data.urgent == false));

      // Authors can edit while PENDING; Moderators can verify and edit all posts
      allow update: if (
        isAuthenticated() &&
        resource.data.author_id == request.auth.uid &&
        resource.data.verification_status == 'PENDING' &&
        request.resource.data.author_id == resource.data.author_id
      ) || isModerator() ||
      // Allow like count / liked_by toggle
      (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count', 'liked_by', 'comments_count', 'reports_count'])
      );

      allow delete: if (isAuthenticated() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    // ===============================================================
    // Comments
    // ===============================================================
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.author_id == request.auth.uid &&
        validStringLength(request.resource.data.text, 1, 2000);

      allow update: if isAuthenticated() &&
        resource.data.author_id == request.auth.uid &&
        request.resource.data.author_id == resource.data.author_id &&
        validStringLength(request.resource.data.text, 1, 2000);

      allow delete: if (isAuthenticated() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    // ===============================================================
    // Village Events & RSVPs
    // ===============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isEventOrganizer();

      // Organizers can edit; Any signed-in user can RSVP / update registered_uids
      allow update: if isEventOrganizer() ||
        (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered_uids', 'participants_count'])
        );
    }

    // ===============================================================
    // Sports & Tournaments
    // ===============================================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isSportsOrganizer();
    }

    // ===============================================================
    // Static Village Data & Admin Catalogues
    // ===============================================================
    match /village_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crops/{cropId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /temples/{templeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /history/{historyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    match /emergency_alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // Reports & Grievances
    // ===============================================================
    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reporter_id == request.auth.uid &&
        validStringLength(request.resource.data.reason, 1, 1000);
      allow read, update, delete: if isModerator();
    }

    // ===============================================================
    // Notifications (User-Scoped Only)
    // ===============================================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || resource.data.user_id == 'ALL');
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // ===============================================================
    // Private Conversations & Messages (Participant-Scoped Only)
    // ===============================================================
    match /conversations/{convId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
    }

    match /messages/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.sender_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.sender_id == request.auth.uid;
    }

    match /user_blocks/{blockId} {
      allow read: if isAuthenticated() && resource.data.blocker_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.blocker_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.blocker_id == request.auth.uid;
    }
  }
}
