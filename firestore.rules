rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for Authentication & RBAC
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }
    
    function isAdmin() {
      return isSuperAdmin() || hasRole('ADMIN');
    }
    
    function isModerator() {
      return isAdmin() || hasRole('MODERATOR');
    }
    
    function isSportsOrganizer() {
      return isAdmin() || hasRole('SPORTS_ORGANIZER');
    }
    
    function isEventOrganizer() {
      return isAdmin() || hasRole('EVENT_ORGANIZER');
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // User can create their initial profile, but role must be 'USER' unless super admin
      allow create: if isUser(userId) && request.resource.data.role == 'USER';
      // User can update their own profile info, but CANNOT escalate their own role
      allow update: if isUser(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'account_status'])) ||
        isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Community News & Posts
    match /news/{newsId} {
      allow read: if resource.data.verification_status in ['VERIFIED', 'COMMUNITY_REPORT'] || isModerator() || (isSignedIn() && resource.data.author_id == request.auth.uid);
      // Authenticated users can submit, but cannot self-verify or mark urgent
      allow create: if isSignedIn() &&
        request.resource.data.author_id == request.auth.uid &&
        request.resource.data.verification_status in ['PENDING', 'COMMUNITY_REPORT'] &&
        request.resource.data.urgent == false;
      // Author can edit before verification; Moderators can verify, reject, edit, mark urgent
      allow update: if (isSignedIn() && resource.data.author_id == request.auth.uid && resource.data.verification_status == 'PENDING') ||
        isModerator();
      allow delete: if (isSignedIn() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.author_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.author_id == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    // Events
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isEventOrganizer();
      
      match /participants/{userId} {
        allow read: if true;
        allow write: if isUser(userId) || isEventOrganizer();
      }
    }

    // Sports & Tournaments
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isSportsOrganizer();
      
      match /matches/{matchId} {
        allow read: if true;
        allow write: if isSportsOrganizer();
      }
    }

    // Village Official Statistics (Strict Admin Only)
    match /village_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Agriculture Hub
    match /crops/{cropId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Temples & Heritage
    match /temples/{templeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // History & Village Stories
    match /history/{historyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /stories/{storyId} {
      allow read: if resource.data.verified == true || isModerator() || (isSignedIn() && resource.data.author_id == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    // Achievements
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Photo & Video Gallery
    match /gallery/{galleryId} {
      allow read: if resource.data.approved == true || isModerator() || (isSignedIn() && resource.data.author_id == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.author_id == request.auth.uid;
      allow update: if isModerator();
      allow delete: if (isSignedIn() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    // Social Links
    match /social_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Emergency Alerts (Admin/Moderator Only)
    match /emergency_alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reports System
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow read, update, delete: if isModerator();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.broadcast == true);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit logs
    }

    // Private Conversations (Participant-Scoped Only)
    match /conversations/{convId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
    }

    // Chat Messages (Only conversation participants can read; only author can delete)
    match /messages/{msgId} {
      allow read: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversation_id)).data.participants
      );
      allow create: if isSignedIn() &&
        request.resource.data.sender_id == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversation_id)).data.participants;
      allow update: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversation_id)).data.participants
      );
      allow delete: if isSignedIn() && resource.data.sender_id == request.auth.uid;
    }

    // User Blocks & Privacy
    match /user_blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blocker_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.blocker_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blocker_id == request.auth.uid;
    }
  }
}
