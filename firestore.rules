rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (matches request.auth.uid)
// Fields:
//   - uid: string (required, immutable)
//   - name: string (required, 1-100 chars)
//   - email: string (optional, valid email format)
//   - phone: string (optional, 10-20 chars)
//   - role: string ('SUPER_ADMIN', 'ADMIN', 'MODERATOR', 'SPORTS_ORGANIZER', 'EVENT_ORGANIZER', 'USER')
//   - account_status: string ('ACTIVE', 'SUSPENDED', 'BANNED')
//   - created_at: string (ISO date string, immutable)
//   - last_login: string (ISO date string)
//
// Collection: news
// Document ID: {newsId}
// Fields:
//   - id: string (required, immutable)
//   - title_en: string (required, 1-200 chars)
//   - title_kn: string (required, 1-200 chars)
//   - content_en: string (required, 1-10000 chars)
//   - content_kn: string (required, 1-10000 chars)
//   - author_id: string (required, matches request.auth.uid, immutable)
//   - author_name: string (required, 1-100 chars)
//   - verification_status: string ('PENDING', 'VERIFIED', 'REJECTED', 'COMMUNITY_REPORT')
//   - urgent: bool (required)
//   - created_at: string (ISO date string, immutable)
//
// Collection: events
// Document ID: {eventId}
// Fields:
//   - id: string (required, immutable)
//   - title_en: string (required, 1-200 chars)
//   - title_kn: string (required, 1-200 chars)
//   - event_date: string (required, 1-50 chars)
//   - location_en: string (required, 1-200 chars)
//   - participants_count: number (>= 0)
//   - registered_uids: list (list of user IDs)
//
// Collection: comments
// Document ID: {commentId}
// Fields:
//   - id: string (required, immutable)
//   - post_id: string (required, 1-100 chars)
//   - author_id: string (required, matches request.auth.uid, immutable)
//   - author_name: string (required, 1-100 chars)
//   - text: string (required, 1-2000 chars)
//   - created_at: string (ISO date string, immutable)
//
// Collection: reports
// Document ID: {reportId}
// Fields:
//   - id: string (required, immutable)
//   - item_id: string (required)
//   - item_type: string ('POST', 'USER', 'COMMENT', 'MESSAGE')
//   - reporter_id: string (required, matches request.auth.uid, immutable)
//   - reason: string (required, 1-1000 chars)
//   - status: string ('PENDING', 'RESOLVED', 'DISMISSED')
//   - created_at: string (ISO date string, immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Core Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == role;
    }

    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }

    function isAdmin() {
      return isSuperAdmin() || hasRole('ADMIN');
    }

    function isModerator() {
      return isAdmin() || hasRole('MODERATOR');
    }

    function isSportsOrganizer() {
      return isAdmin() || hasRole('SPORTS_ORGANIZER');
    }

    function isEventOrganizer() {
      return isAdmin() || hasRole('EVENT_ORGANIZER');
    }

    function validStringLength(text, minLen, maxLen) {
      return text is string && text.size() >= minLen && text.size() <= maxLen;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Users Collection (Profile Directory & RBAC)
    // ===============================================================
    match /users/{userId} {
      // Allow reading user profiles so community author details and member directory load
      allow read: if true;

      // Account owner or Admin can create/update their profile
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // News & Community Posts
    // ===============================================================
    match /news/{newsId} {
      // News and community updates are visible to all users instantly in real-time
      allow read: if true;

      // Any authenticated user can create posts with photos
      allow create: if isAuthenticated();

      // Authors can edit; moderators can verify; any user can like/comment
      allow update: if isAuthenticated();

      // Authors or moderators can delete
      allow delete: if (isAuthenticated() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    // ===============================================================
    // Comments
    // ===============================================================
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.author_id == request.auth.uid &&
        validStringLength(request.resource.data.text, 1, 2000);

      allow update: if isAuthenticated() &&
        resource.data.author_id == request.auth.uid &&
        request.resource.data.author_id == resource.data.author_id &&
        validStringLength(request.resource.data.text, 1, 2000);

      allow delete: if (isAuthenticated() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    // ===============================================================
    // Village Events & RSVPs
    // ===============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isEventOrganizer() || isAdmin() || (isAuthenticated() && resource.data.author_id == request.auth.uid);
    }

    // ===============================================================
    // Sports & Tournaments
    // ===============================================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isSportsOrganizer() || isAdmin();
    }

    // ===============================================================
    // Static Village Data & Admin Catalogues
    // ===============================================================
    match /village_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crops/{cropId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /temples/{templeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /history/{historyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && resource.data.author_id == request.auth.uid) || isModerator();
    }

    match /emergency_alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // Reports & Grievances
    // ===============================================================
    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reporter_id == request.auth.uid &&
        validStringLength(request.resource.data.reason, 1, 1000);
      allow read, update, delete: if isAuthenticated();
    }

    // ===============================================================
    // Notifications (User-Scoped Only)
    // ===============================================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || resource.data.user_id == 'ALL');
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // ===============================================================
    // Private Conversations & Messages (Participant-Scoped Only)
    // ===============================================================
    match /conversations/{convId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
    }

    match /messages/{msgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.sender_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.sender_id == request.auth.uid;
    }

    match /user_blocks/{blockId} {
      allow read: if isAuthenticated() && resource.data.blocker_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.blocker_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.blocker_id == request.auth.uid;
    }
  }
}
